# Copiar este archivo como ".env" y completar los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ver .gitignore).

# Clave secreta de Django. Generar una propia, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-generada-para-tu-proyecto

# True solo en desarrollo local. En la instancia EC2 debe quedar en False.
DEBUG=True

# Hosts permitidos, separados por coma. En EC2 agregar la IP pública o el
# DNS de la instancia, ej: 127.0.0.1,localhost,3.15.20.10
ALLOWED_HOSTS=127.0.0.1,localhost

# Motor de base de datos: "sqlite" para desarrollo local rápido,
# "mysql" para la instancia EC2 (con phpMyAdmin).
DB_ENGINE=sqlite

# Solo se usan si DB_ENGINE=mysql
DB_NAME=sgr_evaluacion
DB_USER=sgr_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=3306
